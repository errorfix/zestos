# =============================================================================
# FestOS v2.0 • Environment Configuration Template
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 1 (RECOMMENDED): Self-Hosted PostgreSQL on Hostinger VPS (Docker)
# Unlimited connections, 0ms latency, zero monthly cost, never pauses.
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="FestOS_Production_Secret_Pass_2026"
POSTGRES_DB="zestos"

# Connection strings used inside Docker (notice "db" is the docker service name):
DATABASE_URL="postgresql://postgres:FestOS_Production_Secret_Pass_2026@db:5432/zestos?schema=public"
DIRECT_URL="postgresql://postgres:FestOS_Production_Secret_Pass_2026@db:5432/zestos?schema=public"

# (For local dev on Mac when running postgres outside docker, use localhost:5432)
# DATABASE_URL="postgresql://postgres:FestOS_Production_Secret_Pass_2026@localhost:5432/zestos?schema=public"
# DIRECT_URL="postgresql://postgres:FestOS_Production_Secret_Pass_2026@localhost:5432/zestos?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 2: External Supabase Managed PostgreSQL (Legacy / Fallback)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Razorpay Credentials (Test Mode for Staging, Live for Production)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Ticket Cryptography Secret (HMAC SHA-256)
HMAC_TICKET_SECRET="festos-v2-lingayas-vidyapeeth-hmac-sha256-secret-key-2026"

# Supabase Storage & Public Access (Optional if using Supabase client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"


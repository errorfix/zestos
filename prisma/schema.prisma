datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Event {
  id                  String         @id @default(cuid())
  title               String
  category            String         // Cultural - Music, Cultural - Dance, Cultural - Theatre, Cultural - Fashion, Literary, Informalz, Gaming
  eventType           String         @default("Individual") // Individual, Team
  feeAmount           Int            // Stored in paise (INR 100 = 10000, 0 = FREE)
  minTeamSize         Int            @default(1)
  maxTeamSize         Int            @default(1)
  prize1              String?        // 1st Prize description
  prize2              String?        // 2nd Prize description
  description         String?
  rules               String?
  venue               String?
  date                String?        // Day 1, Day 2, or specific time
  status              String         @default("OPEN") // OPEN, CLOSED
  requiresTrackUpload Boolean        @default(false)  // Audio / Video stage track needed
  hasDayOptions       Boolean        @default(false)  // Legacy flag
  onSpotFeeAmount     Int?           // Optional on-spot walk-in counter fee in paise
  registrations       Registration[]
  instituteParticipants InstituteParticipant[]
}

model Registration {
  id                String       @id @default(cuid())
  eventId           String
  event             Event        @relation(fields: [eventId], references: [id])
  leadName          String
  leadEmail         String
  leadPhone         String?
  college           String?
  photoUrl          String?      // Compressed attendee photo data URL
  payerName         String?      // Payer name recorded during payment
  amount            Int?         // Amount paid in paise
  status            String       @default("PENDING") // PENDING, PAID, FAILED
  paymentMethod     String?      @default("ONLINE_RAZORPAY") // ONLINE_RAZORPAY, ONSPOT_CASH, ONSPOT_UPI, FREE_REGISTRATION
  dayOption         String?      // DAY_1, DAY_2, BOTH_DAYS
  trackUploadUrl    String?      // Link to Google Drive track / media asset
  trackNotes        String?      // Stage sound / lighting cues / song name
  razorpayOrderId   String?      @unique
  razorpayPaymentId String?      @unique
  teamMembers       TeamMember[]
  tickets           Ticket[]
  createdAt         DateTime     @default(now())
}

model TeamMember {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fullName       String
  phone          String?
  college        String?
  photoUrl       String?
  rollNumber     String?
}

model Ticket {
  id             String       @id @default(cuid())
  ticketCode     String       @unique // e.g., LV-TKT-2026-X89K
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fullName       String?
  college        String?
  photoUrl       String?
  status         String       @default("ISSUED") // ISSUED, CHECKED_IN
  securityHash   String       // HMAC-SHA256 signature for offline validation
  checkedInAt    DateTime?
}

model AuditLog {
  id              String   @id @default(cuid())
  targetId        String   // Object ID of the edited record (e.g. registration ID, event ID)
  action          String   // e.g. UPDATE_STAGE_TRACK, EDIT_EVENT, TOGGLE_FLAG, ONSPOT_REGISTRATION
  targetType      String   // e.g. REGISTRATION, EVENT, STAGE_TRACK, COMMITTEE_FLAG, TICKET
  operatorName    String   // Student Name or Faculty Name
  operatorRollNo  String   // Student Roll Number or Faculty ID
  operatorType    String?  @default("STUDENT") // STUDENT or FACULTY
  committeeRoleId String   // Active committee role
  changes         String?  // Summary or JSON of modified attributes
  createdAt       DateTime @default(now())

  @@index([targetId])
  @@index([operatorRollNo])
  @@index([action])
  @@index([createdAt])
}

model InstituteRegistration {
  id                String                 @id @default(cuid())
  instituteName     String
  leaderName        String
  leaderEmail       String
  leaderPhone       String
  leaderPhotoUrl    String?
  totalAmount       Int                    // Paid in paise (inclusive of ₹1,000 floor)
  paymentStatus     String                 @default("PENDING") // PENDING, PAID, FAILED
  paymentMethod     String?                @default("ONLINE_RAZORPAY")
  razorpayOrderId   String?                @unique
  razorpayPaymentId String?                @unique
  participants      InstituteParticipant[]
  createdAt         DateTime               @default(now())

  @@index([instituteName])
  @@index([leaderPhone])
}

model InstituteParticipant {
  id             String                @id @default(cuid())
  registrationId String
  registration   InstituteRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  instituteName  String
  eventId        String
  event          Event                 @relation(fields: [eventId], references: [id])
  fullName       String
  phone          String
  photoUrl       String?
  isTeamLeader   Boolean               @default(false)
  festivalDay    String?               // DAY_1, DAY_2, BOTH_DAYS
  ticketCode     String?               // Unique day-wise ticket code
  securityHash   String?
  createdAt      DateTime              @default(now())

  @@index([phone])
  @@index([instituteName, phone])
}

model DailyTrackingItem {
  id                 String    @id @default(cuid())
  committeeId        String    // e.g. MUSIC_COMMITTEE, STAGE_COMMITTEE, REGISTRATION_COMMITTEE
  committeeName      String    // Human-readable committee name
  date               String    // YYYY-MM-DD daily reporting date
  head               String    // Functional Department/Head (e.g. "Logistics & Equipment")
  subhead            String    // Specific Workstream/Subhead (e.g. "Drum Kit Rental")
  title              String    // Short title / milestone summary
  workDescription    String    // Detailed work done for the day
  status             String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, DELAYED, BLOCKED, PENDING_REVIEW
  progressPercentage Int       @default(0) // 0 to 100%
  blockers           String?   // Remarks on bottlenecks, delays, or required approvals
  operatorName       String    // Coordinator / Member Name
  operatorRollNo     String    // Roll Number or Faculty ID
  operatorType       String?   @default("STUDENT") // STUDENT or FACULTY
  attachmentsUrl     String?   // Link to Google Drive / photos / proof
  superAdminRemarks  String?   // Feedback / Directives from Super Admin
  superAdminReviewed Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([committeeId])
  @@index([date])
  @@index([head])
  @@index([status])
}

model CommitteeAttendance {
  id             String   @id @default(cuid())
  committeeId    String   // e.g. DANCE_COMMITTEE, MUSIC_COMMITTEE, INFRA_COMMITTEE
  date           String   // YYYY-MM-DD
  rollNumber     String   // varchar 20 student roll number
  isPresent      Boolean  @default(false)
  facultyName    String?  // Name of faculty in-charge who submitted
  facultyRollNo  String?  // Faculty Employee ID
  createdAt      DateTime @default(now())

  @@unique([committeeId, date, rollNumber])
  @@index([committeeId, date])
  @@index([rollNumber])
}

model CommitteeAttendancePublish {
  id            String   @id @default(cuid())
  committeeId   String   // e.g. DANCE_COMMITTEE
  date          String   // YYYY-MM-DD
  publishedAt   DateTime @default(now())
  facultyName   String
  facultyRollNo String
  totalPresent  Int      @default(0)
  totalAbsent   Int      @default(0)

  @@unique([committeeId, date])
  @@index([committeeId])
  @@index([date])
}

model SupportTicket {
  id             String   @id @default(cuid())
  committeeId    String   // Originating committee ID
  committeeName  String   // Human-readable committee name
  concern        String   // Detailed issue / concern paragraph
  status         String   @default("UNSOLVED") // UNSOLVED, SOLVED
  operatorName   String?
  operatorRollNo String?
  operatorType   String?  @default("STUDENT") // STUDENT or FACULTY
  resolvedBy     String?  // Operator / Admin who marked solved
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([committeeId])
  @@index([status])
  @@index([createdAt])
}

model Complaint {
  id             String   @id @default(cuid())
  committeeId    String   // Originating committee ID
  committeeName  String   // Human-readable committee name
  topic          String   // Brief subject / sentence
  explanation    String   // Detailed explanation paragraph
  status         String   @default("UNSOLVED") // UNSOLVED, SOLVED
  operatorName   String?
  operatorRollNo String?
  operatorType   String?  @default("STUDENT") // STUDENT or FACULTY
  resolvedBy     String?  // Grievance / CS&IT member who resolved
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([committeeId])
  @@index([status])
  @@index([createdAt])
}

model InfraVendor {
  id             String   @id @default(cuid())
  name           String   // Vendor Agency / Company Name
  purpose        String   // Equipment / Service Purpose (e.g. Stage Sound, Generator, Barricades)
  remarks        String?  // Specifications, payment notes, delivery timing
  contactPhone   String?
  status         String   @default("ACTIVE") // ACTIVE, PENDING, COMPLETED, CANCELLED
  operatorName   String?
  operatorRollNo String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model CommitteeRosterMember {
  id          String   @id @default(cuid())
  committeeId String   // Committee slug / ID
  rollNumber  String   // varchar 20 roll number
  studentName String?  // Optional student name
  createdAt   DateTime @default(now())

  @@unique([committeeId, rollNumber])
  @@index([committeeId])
}


